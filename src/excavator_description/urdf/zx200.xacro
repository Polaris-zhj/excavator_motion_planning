<?xml version="1.0"?>
<robot name="zx200" xmlns:xacro="http://www.ros.org/wiki/xacro">

	<!-- Import all Gazebo-customization elements, including Gazebo colors -->
	<!-- <xacro:include filename="$(find zx200_description)/urdf/zx200.gazebo" /> -->
	<!-- Import Rviz colors -->
	<!-- <xacro:include filename="$(find zx200_description)/urdf/materials.xacro" /> -->

	<!-- RViz and the rest of the project use world as the fixed frame. -->
	<link name="world"/>
	<joint name="world_to_base_link" type="fixed">
		<parent link="world"/>
		<child link="base_link"/>
	</joint>

	<!-- Used for fixing robot to Gazebo 'base_link' -->
	<link name="base_link"/>

	<joint name="base_joint" type="fixed">
		<parent link="base_link"/>
		<child link="track_link"/>
	</joint>

	<!-- Base Link -->
	<link name="track_link">
		<visual>
			<geometry>
				<mesh filename="package://excavator_description/meshes/zx200-crawler.dae"/>
			</geometry>
		</visual>

		<collision>
			<geometry>
				<mesh filename="package://excavator_description/meshes/zx200-crawler-collision.stl"/>
			</geometry>
		</collision>

		<inertial>
			<origin xyz="0 0 0" rpy="0 0 0"/>
			<mass value="0.03"/>
			<inertia ixx="1.0" ixy="0.0" ixz="0.0"
					 iyy="1.0" iyz="0.0"
					 izz="1.0"/>
		</inertial>
	</link>

	<!-- body axis -->
	<joint name="swing_joint" type="revolute">
		<origin xyz="0.10787 -0.034301 1.1206"/>
		<axis xyz="0 0 1"/>
		<parent link="track_link"/>
		<child link="swing_link"/>
		<limit lower="-6.2832" upper="6.2832"
			   effort="5000" velocity="6.159937255"/>
	</joint>

	<link name="swing_link">
		<visual>
			<origin xyz="0 0 0"/>
			<geometry>
				<mesh filename="package://excavator_description/meshes/zx200-body.dae"/>
			</geometry>
		</visual>

		<collision>
			<origin xyz="0 0 0"/>
			<geometry>
				<mesh filename="package://excavator_description/meshes/zx200-body-collision.stl"/>
			</geometry>
		</collision>

		<inertial>
			<origin xyz="0 0 0" rpy="0 0 0"/>
			<mass value="0.03"/>
			<inertia ixx="1.0" ixy="0.0" ixz="0.0"
					 iyy="1.0" iyz="0.0"
					 izz="1.0"/>
		</inertial>
	</link>

	<!-- boom axis -->
	<joint name="boom_joint" type="revolute">
		<origin rpy="0 ${radians(32.0357)} 0"
				xyz="0.05467 -0.040187 0.72492"/>
		<axis xyz="0 1 0"/>
		<parent link="swing_link"/>
		<child link="boom_link"/>
		<limit lower="-1.137"
			   upper="1.0"
			   effort="500"
			   velocity="6.159937255"/>
	</joint>

	<link name="boom_link">
		<visual>
			<origin xyz="0 0 0"/>
			<geometry>
				<mesh filename="package://excavator_description/meshes/zx200-boom.dae"/>
			</geometry>
		</visual>

		<collision>
			<origin xyz="0 0 0"/>
			<geometry>
				<mesh filename="package://excavator_description/meshes/zx200-boom-collision.stl"/>
			</geometry>
		</collision>

		<inertial>
			<origin xyz="0 0 0" rpy="0 0 0"/>
			<mass value="0.03"/>
			<inertia ixx="1.0" ixy="0.0" ixz="0.0"
					 iyy="1.0" iyz="0.0"
					 izz="1.0"/>
		</inertial>
	</link>

	<joint name="stick_joint" type="revolute">
		<origin rpy="0 ${radians(16.9707)} 0"
				xyz="4.83998 0.010957 3.00227"/>
		<axis xyz="0 1 0"/>
		<parent link="boom_link"/>
		<child link="stick_link"/>
		<limit lower="0.594"
			   upper="2.687"
			   effort="500"
			   velocity="6.159937255"/>
	</joint>

	<link name="stick_link">
		<visual>
			<origin xyz="0 0 0"/>
			<geometry>
				<mesh filename="package://excavator_description/meshes/zx200-arm.dae"/>
			</geometry>
		</visual>

		<collision>
			<origin xyz="0 0 0"/>
			<geometry>
				<mesh filename="package://excavator_description/meshes/zx200-arm-collision.stl"/>
			</geometry>
		</collision>

		<inertial>
			<origin xyz="0 0 0" rpy="0 0 0"/>
			<mass value="0.03"/>
			<inertia ixx="1.0" ixy="0.0" ixz="0.0"
					 iyy="1.0" iyz="0.0"
					 izz="1.0"/>
		</inertial>
	</link>

	<!-- bucket axis -->
	<joint name="bucket_joint" type="revolute">
		<origin rpy="0 ${radians(-9.20083)} 0"
				xyz="1.91546 -0.023546 2.17374"/>
		<axis xyz="0 1 0"/>
		<parent link="stick_link"/>
		<child link="bucket_link"/>
		<limit lower="-0.622"
			   upper="2.372"
			   effort="50000"
			   velocity="6.159937255"/>
	</joint>

	<link name="bucket_link">
		<visual>
			<origin xyz="0 0 0"/>
			<geometry>
				<mesh filename="package://excavator_description/meshes/zx200-bucket.dae"/>
			</geometry>
		</visual>

		<collision>
			<origin xyz="0 0 0"/>
			<geometry>
				<mesh filename="package://excavator_description/meshes/zx200-bucket-collision.stl"/>
			</geometry>
		</collision>

		<inertial>
			<origin xyz="0 0 0" rpy="0 0 0"/>
			<mass value="0.03"/>
			<inertia ixx="1.0" ixy="0.0" ixz="0.0"
					 iyy="1.0" iyz="0.0"
					 izz="1.0"/>
		</inertial>
	</link>

	<link name="bucket_tip">
		<visual>
			<origin xyz="0 0 0" rpy="0 0 0"/>
			<geometry>
				<box size="0.001 0.001 0.001"/>
			</geometry>
		</visual>

		<inertial>
			<origin xyz="0 0 0"/>
			<mass value="1.0e-03"/>
			<inertia ixx="1.0e-03" ixy="0.0" ixz="0.0"
					 iyy="1.0e-03" iyz="0.0"
					 izz="1.0e-03"/>
		</inertial>
	</link>

	<joint name="bucket_tip_joint" type="fixed">
		<parent link="bucket_link"/>
		<child link="bucket_tip"/>
		<origin xyz="1.13012 0 0.93856" rpy="0 0 0"/>
	</joint>

	<transmission name="tran1">
		<type>transmission_interface/SimpleTransmission</type>
		<joint name="swing_joint">
			<hardwareInterface>
				hardware_interface/EffortJointInterface
			</hardwareInterface>
		</joint>
		<actuator name="motor1">
			<hardwareInterface>
				hardware_interface/EffortJointInterface
			</hardwareInterface>
			<mechanicalReduction>1</mechanicalReduction>
		</actuator>
	</transmission>

	<transmission name="tran2">
		<type>transmission_interface/SimpleTransmission</type>
		<joint name="boom_joint">
			<hardwareInterface>
				hardware_interface/EffortJointInterface
			</hardwareInterface>
		</joint>
		<actuator name="motor2">
			<hardwareInterface>
				hardware_interface/EffortJointInterface
			</hardwareInterface>
			<mechanicalReduction>1</mechanicalReduction>
		</actuator>
	</transmission>

	<transmission name="tran3">
		<type>transmission_interface/SimpleTransmission</type>
		<joint name="stick_joint">
			<hardwareInterface>
				hardware_interface/EffortJointInterface
			</hardwareInterface>
		</joint>
		<actuator name="motor3">
			<hardwareInterface>
				hardware_interface/EffortJointInterface
			</hardwareInterface>
			<mechanicalReduction>1</mechanicalReduction>
		</actuator>
	</transmission>

	<transmission name="tran4">
		<type>transmission_interface/SimpleTransmission</type>
		<joint name="bucket_joint">
			<hardwareInterface>
				hardware_interface/EffortJointInterface
			</hardwareInterface>
		</joint>
		<actuator name="motor4">
			<hardwareInterface>
				hardware_interface/EffortJointInterface
			</hardwareInterface>
			<mechanicalReduction>1</mechanicalReduction>
		</actuator>
	</transmission>

</robot>