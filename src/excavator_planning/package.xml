<?xml version="1.0"?>
<package format="3">
  <name>excavator_planning</name>
  <version>0.1.0</version>
  <description>Replaceable baseline joint-space planner and trajectory processing implementations.</description>
  <maintainer email="maintainer@example.com">Excavator Motion Planning Contributors</maintainer>
  <license>Apache-2.0</license>
  <buildtool_depend>ament_cmake</buildtool_depend>
  <depend>excavator_common</depend>
  <depend>rclcpp</depend>
  <depend>rclcpp_action</depend>
  <depend>builtin_interfaces</depend>
  <depend>sensor_msgs</depend>
  <depend>shape_msgs</depend>
  <depend>trajectory_msgs</depend>
  <depend>visualization_msgs</depend>
  <depend>excavator_interfaces</depend>
  <depend>kinematics</depend>
  <depend>excavator_collision</depend>
  <depend>pluginlib</depend>
  <exec_depend>xacro</exec_depend>
  <exec_depend>excavator_description</exec_depend>
  <test_depend>ament_cmake_gtest</test_depend>
  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
