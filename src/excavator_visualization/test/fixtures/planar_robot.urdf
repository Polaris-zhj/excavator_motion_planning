<?xml version="1.0"?>
<robot name="test_arm">
  <link name="base"/>
  <link name="arm"/>
  <link name="tool"/>
  <joint name="joint_a" type="revolute">
    <parent link="base"/>
    <child link="arm"/>
    <origin xyz="1 0 0" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3.14" upper="3.14" effort="10" velocity="1"/>
  </joint>
  <joint name="tool_fixed" type="fixed">
    <parent link="arm"/>
    <child link="tool"/>
    <origin xyz="1 0 0" rpy="0 0 0"/>
  </joint>
</robot>
